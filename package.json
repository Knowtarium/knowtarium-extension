{
  "name": "knowtarium-extension",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "The Knowtarium web clipper: save the page you're on to your Knowtarium inbox, end-to-end encrypted.",
  "homepage": "https://knowtarium.com",
  "bugs": {
    "url": "https://github.com/Knowtarium/knowtarium-extension/issues",
    "email": "support@knowtarium.com"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Knowtarium/knowtarium-extension.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build --mode production",
    "build:staging": "vite build --mode staging",
    "build:dev": "vite build --mode development",
    "dev": "vite build --mode development --watch",
    "package": "pnpm build && node scripts/package.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "knowtarium": "link:../app-clipper",
    "libsodium-wrappers": "0.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/chrome": "^0.1.43",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
